# systemd user unit for Meridian Console. Installed by deploy/install.sh (see docs/deploy.md).
# It runs the prod worktree, which deploy/deploy-prod.sh keeps at the tip of main.
[Unit]
Description=Meridian Console
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/meridian-prod
# NOX works on the development checkout, not on the worktree this runs from.
Environment=MERIDIAN_REPO_ROOT=%h/jarvis
# A login shell, so PATH has what the owner's shell has (claude, cargo...); Node comes from nvm (see .nvmrc).
ExecStart=/bin/bash -lc '. "$HOME/.nvm/nvm.sh" && nvm use 24 >/dev/null && exec pnpm --filter @meridian/server start'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
