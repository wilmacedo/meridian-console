{
  "name": "meridian-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev:web": "pnpm --filter @meridian/web dev",
    "dev:server": "pnpm --filter @meridian/server dev",
    "build": "pnpm --filter @meridian/web build && pnpm --filter @meridian/server build",
    "typecheck": "pnpm -r typecheck",
    "tuya": "pnpm --filter @meridian/server tuya"
  }
}
