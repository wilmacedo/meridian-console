{
  "name": "meridian-console",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev:web": "pnpm --filter @meridian/web dev",
    "dev:server": "pnpm --filter @meridian/server dev",
    "build": "pnpm --filter @meridian/web build",
    "start": "pnpm build && pnpm --filter @meridian/server start",
    "typecheck": "pnpm -r typecheck",
    "tuya": "pnpm --filter @meridian/service-tuya-feeder tuya",
    "test": "pnpm -r --if-present test",
    "nox": "pnpm --filter @meridian/server nox"
  }
}
