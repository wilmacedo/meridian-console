# Tuya IoT Platform (iot.tuya.com) -> Cloud -> your project -> Overview
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# API endpoint for the data center chosen when creating the project:
#   Western America  https://openapi.tuyaus.com
#   Eastern America  https://openapi-ueaz.tuyaus.com
#   Central Europe   https://openapi.tuyaeu.com
#   Western Europe   https://openapi-weaz.tuyaeu.com
#   India            https://openapi.tuyain.com
#   China            https://openapi.tuyacn.com
TUYA_API_ENDPOINT=https://openapi.tuyaus.com

# Device ID of the feeder (pnpm tuya scripts/tuya/devices.ts), used by the camera relay.
TUYA_FEEDER_DEVICE_ID=
# Where apps/server reaches go2rtc (defaults to the compose service on localhost).
# GO2RTC_API_URL=http://127.0.0.1:1984

# Host name shown in the header (defaults to the OS host name).
# MERIDIAN_HOST=

# Where Meridian keeps its SQLite database (workspaces). Defaults to ~/.meridian.
# MERIDIAN_DATA_DIR=

# NOX: its home (persona notes, session) and model. Defaults: ~/.meridian/nox and sonnet.
# NOX_HOME=
# NOX_MODEL=

# ElevenLabs (voice): create it in the ElevenLabs dashboard, Developers > API Keys. Keep it server-side.
# ELEVENLABS_API_KEY=

# Voice: the voice id of a Portuguese (Brazil) voice in your ElevenLabs library, and optional model overrides.
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

# browser-harness service (services/browser-harness): read-only access to a Chrome the owner is signed in to.
# Where the Chrome debug port answers on this machine (the SSH tunnel's local end, see the service README).
# MERIDIAN_BROWSER_CDP_URL=http://127.0.0.1:9222
# Comma-separated; a host matches itself and its subdomains. Anything else is refused. Default: appstoreconnect.apple.com
# MERIDIAN_BROWSER_ALLOWED_DOMAINS=appstoreconnect.apple.com
# Audit log and screenshots. Defaults to ~/.meridian/browser-harness.
# MERIDIAN_BROWSER_STATE_DIR=
# SSH host (from ~/.ssh/config) of the machine that runs Chrome. When set, the service opens the SSH tunnel and starts
# Chrome there on demand (and drops the tunnel after a quiet spell); when empty, you bring both up by hand.
# MERIDIAN_BROWSER_SSH_HOST=
# What starts Chrome on that machine, run over ssh. Default (Windows): the scheduled task installed by
# services/browser-harness/scripts/windows-chrome-task.ps1.
# MERIDIAN_BROWSER_LAUNCH_COMMAND=schtasks /run /tn MeridianChrome
# Minutes of quiet before the tunnel it opened is closed. Default 15.
# MERIDIAN_BROWSER_IDLE_MIN=15
# The debug port on the Chrome machine, when it is not 9222.
# MERIDIAN_BROWSER_REMOTE_PORT=
